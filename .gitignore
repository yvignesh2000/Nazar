# Environment & Secrets
nazar/.env
.env
nazar/.master_secret
nazar/.salt
.master_secret
.salt
nazar/data/.token_secret

# Encrypted customer data (sensitive — never commit)
nazar/data/contacts/
nazar/data/chromadb/

# SQLite database files (runtime — never commit)
nazar/data/*.db
nazar/data/*.db-shm
nazar/data/*.db-wal
nazar/nazar.db
nazar/nazar.db-shm
nazar/nazar.db-wal

# Runtime data (generated at runtime — never commit)
nazar/data/auth/
nazar/data/audit/
nazar/data/analytics/
nazar/data/billing/
nazar/data/handoffs/
nazar/data/onboarding/
nazar/data/usage/
nazar/data/campaigns.json
nazar/data/campaign_contacts.json
nazar/data/ai_drafts.json
nazar/data/reply_modes.json

# Knowledge base runtime artefacts (raw docs and folder index are per-tenant data)
nazar/data/kb/raw/
nazar/data/kb/folders.json
nazar/data/kb/docs.json
nazar/data/kb/vectors/
nazar/data/.chroma_health/

# Backup files
*.bak

# Stray pip output files (defensive)
nazar/=*

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.pytest_cache/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.idea/
.vscode/
*.sublime-*

# Node
node_modules/
dashboard/dist/

# Logs
*.log

# Lock files from contact manager
*.lock

# Large media files (screenshots etc.)
*.jpeg
*.jpg
!nazar/dashboard/src/**/*.jpeg
!nazar/dashboard/src/**/*.jpg
