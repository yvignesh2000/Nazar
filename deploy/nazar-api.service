[Unit]
Description=Nazar API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=nazar
Group=nazar
WorkingDirectory=/opt/nazar
EnvironmentFile=/opt/nazar/nazar/.env
Environment=PYTHONPATH=/opt/nazar
ExecStart=/opt/nazar/.venv/bin/uvicorn nazar.server:app \
    --host 0.0.0.0 \
    --port 8002 \
    --workers 1 \
    --log-level info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
