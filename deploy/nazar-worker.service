[Unit]
Description=Nazar Worker
After=network.target nazar-api.service

[Service]
Type=simple
User=nazar
Group=nazar
WorkingDirectory=/opt/nazar
EnvironmentFile=/opt/nazar/nazar/.env
ExecStart=/usr/bin/python3 /opt/nazar/nazar/worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
