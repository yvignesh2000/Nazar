[Unit]
Description=Nazar Worker
After=network.target nazar-api.service
Wants=nazar-api.service

[Service]
Type=simple
User=nazar
Group=nazar
WorkingDirectory=/opt/nazar
EnvironmentFile=/opt/nazar/nazar/.env
Environment=PYTHONPATH=/opt/nazar
ExecStart=/opt/nazar/.venv/bin/python nazar/worker.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
