# Nazar — Environment Variables
# Copy this to .env and fill in your actual API keys

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_ACCESS_TOKEN=your_permanent_access_token
WA_VERIFY_TOKEN=nazar_verify_2026

# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_botfather_token
TELEGRAM_BOT_USERNAME=your_bot_username

# LLM Providers (at least one required)
OPENROUTER_API_KEY=your_openrouter_key
# ANTHROPIC_API_KEY=your_anthropic_key
# GOOGLE_API_KEY=your_google_key

# Voice transcription
GROQ_API_KEY=your_groq_key

# Dashboard auth
NAZAR_API_KEY=nazar_dev_key
NAZAR_OWNER_NAME=Admin
# NAZAR_OWNER_EMAIL=owner@example.com

# Database
# Leave unset to use local SQLite at nazar/data/nazar.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nazar
# Local-only fallback for first boot without running migrations yet.
# Set to 1 only in local development.
# NAZAR_ALLOW_SCHEMA_CREATE=1
NAZAR_WORKSPACE_SLUG=default
NAZAR_WORKSPACE_NAME=Nazar

# Background jobs
# REDIS_URL=redis://localhost:6379/0
# NAZAR_WORKER_POLL_SECONDS=2
# NAZAR_WORKER_BATCH_SIZE=5

# Server
PORT=8001
