# ─────────────────────────────────────────────────────────────────────────────
# Nazar — Environment Variables
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" on your cloud server. Enables stricter behaviour.
NAZAR_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# For production on Railway/Render/VPS — use Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/nazar
#
# Railway auto-sets this when you add a Postgres plugin.
# For local dev without Docker, leave unset to use SQLite:
# DATABASE_URL=
#
# Local-only schema bootstrap (no migrations needed). dev only.
# NAZAR_ALLOW_SCHEMA_CREATE=1

# ── Workspace ─────────────────────────────────────────────────────────────────
NAZAR_WORKSPACE_SLUG=default
NAZAR_WORKSPACE_NAME=Nazar
NAZAR_OWNER_NAME=Admin
NAZAR_OWNER_EMAIL=owner@example.com

# ── Dashboard Auth ────────────────────────────────────────────────────────────
# Change this to a strong random string in production.
NAZAR_API_KEY=nazar_dev_key

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_ACCESS_TOKEN=your_permanent_access_token
WA_VERIFY_TOKEN=nazar_verify_2026

# ── Telegram Bot API (optional — easier for testing) ─────────────────────────
TELEGRAM_BOT_TOKEN=your_botfather_token
TELEGRAM_BOT_USERNAME=your_bot_username

# ── LLM Providers (at least one required) ────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key
# ANTHROPIC_API_KEY=your_anthropic_key
# GOOGLE_API_KEY=your_google_key

# ── Voice transcription ────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_key

# ── Background worker ─────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
# NAZAR_WORKER_POLL_SECONDS=2
# NAZAR_WORKER_BATCH_SIZE=5

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8002
