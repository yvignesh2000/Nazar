# ── Nazar — Environment Variables ──────────────────────────────────────
# Copy this to .env and fill in your actual API keys
#   cp .env.template .env
# ────────────────────────────────────────────────────────────────────────

# ── WhatsApp Cloud API (required for production) ──────────────────────
# Get from: https://developers.facebook.com/apps/ → your app → WhatsApp → API Setup
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_ACCESS_TOKEN=your_permanent_access_token
WA_APP_SECRET=your_app_secret           # REQUIRED: used to verify webhook signatures
WA_VERIFY_TOKEN=nazar_verify_2026       # Must match what you enter in Meta dashboard

# ── LLM Providers (at least one required) ──────────────────────────────
# OpenRouter (recommended — routes to multiple models with failover)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Anthropic Direct (optional — higher quality, higher cost)
# Get from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (optional — fast and cheap)
# Get from: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=AIza...

# ── Voice Transcription ──────────────────────────────────────────────
# Groq (for Whisper-based audio transcription — very fast and cheap)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ── Security ──────────────────────────────────────────────────────────
# API key for dashboard access (change this in production!)
NAZAR_API_KEY=nazar_dev_key_CHANGE_ME

# Secret for signing JWT session tokens (auto-generated if not set)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
NAZAR_TOKEN_SECRET=

# ── Razorpay Payments (required for billing) ─────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Razorpay Plan IDs (create in Razorpay Dashboard → Subscriptions → Plans)
# Or leave empty to auto-create via /api/payments/setup endpoint
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_PRO=

# ── GST / Invoice Details ────────────────────────────────────────────
NAZAR_GSTIN=
NAZAR_PAN=
NAZAR_ADDRESS=
NAZAR_STATE=

# ── Server ────────────────────────────────────────────────────────────
PORT=8001

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated allowlist of origins permitted to call the API from a browser.
# Leave empty for safe localhost defaults (dev). REQUIRED in production.
# Example: NAZAR_CORS_ORIGINS=https://app.nazar.example,https://admin.nazar.example
# Avoid "*" — it disables credentialed CORS and weakens browser-side defenses.
NAZAR_CORS_ORIGINS=
